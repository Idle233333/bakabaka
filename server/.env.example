# 复制此文件为 .env 并填入真实值

# 服务端口
PORT=3000

# 数据库
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASS=your_db_password
DB_NAME=ai_chat

# JWT 密钥
JWT_SECRET=your_jwt_secret

# DeepSeek
DEEPSEEK_API_KEY=your_deepseek_api_key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
# 可选：图片识别的多模态模型，默认用 DEEPSEEK_MODEL
# DEEPSEEK_VISION_MODEL=deepseek-chat

# SMTP（注册验证码邮件）
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your_email
SMTP_PASS=your_smtp_password
SMTP_FROM=your_email

# 更新包 AES-256 加密密钥（64 位 hex），必须与客户端 UpdateCrypto.kt 的 KEY_HEX 一致
UPDATE_KEY=your_64_hex_update_key

# 管理员账号（逗号分隔，可跳过每日消息/角色创建上限）
ADMIN_ACCOUNTS=admin

# 角色主动发消息概率（0-1）
PROACTIVE_CHANCE=0.1

# AI 每日消息上限
MESSAGE_LIMIT=100

# 可选：角色每日创建上限（默认 3）
# AGENT_DAILY_LIMIT=3
